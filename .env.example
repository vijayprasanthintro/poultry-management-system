# ============================================================
# BALASUBRAMANI POULTRY - Environment variables
# Copy to .env in the project root and fill in real values.
# The backend also accepts backend/.env, which overrides the root file.
# Never commit a real .env file.
# ============================================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/poultry
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/poultry

# ---- Security ----
# Use a long random string (at least 16 characters) in real deployments.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated origins allowed to call the API in production.
CLIENT_URL=http://localhost:5173

# ---- Optional frontend override ----
# Leave empty to use the Vite dev-server proxy (/api -> localhost:5000).
# Set only if the React app talks to a separately hosted API.
VITE_API_URL=

# ---- Seed admin (only used by `npm run seed`) ----
ADMIN_NAME=BALA SUBRAMANI
ADMIN_USERNAME=bala
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@example.com

# ---- Egg price service (optional) ----
# If unset or unavailable the app keeps the last known price and allows manual entry.
EGG_PRICE_API_URL=
EGG_PRICE_API_KEY=
EGG_PRICE_API_KEY_HEADER=x-api-key
EGG_PRICE_API_PRICE_PATH=price
